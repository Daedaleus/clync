# ── Domain ─────────────────────────────────────────────────────────────────────
# All three services share one domain with path-based routing.
# The Traefik labels in docker-compose.paths.yml must use PathPrefix rules for
# backend (/api) and keycloak (/auth) — see infrastructure/README.md.
FRONTEND_HOST=whatsup.example.test
API_HOST=whatsup.example.test
KEYCLOAK_HOST=whatsup.example.test

# ── Frontend (baked into image at docker compose build) ────────────────────────
VITE_API_URL=https://whatsup.example.test/api
VITE_KEYCLOAK_URL=https://whatsup.example.test/auth
VITE_KEYCLOAK_REALM=WhatsUp
VITE_KEYCLOAK_CLIENT_ID=whatsup

# Backend CORS origin
FRONTEND_URL=https://whatsup.example.test

# ── VAPID (Web Push) ───────────────────────────────────────────────────────────
# Generate fresh keys — do not reuse dev keys in production:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test

# ── RAWG (optional game autofill) ─────────────────────────────────────────────
# Get a free key at https://rawg.io/apidocs — leave empty to disable.
RAWG_API_KEY=

# ── SurrealDB ──────────────────────────────────────────────────────────────────
SURREALDB_USER=surrealdb
SURREALDB_PASS=

# ── Keycloak ───────────────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASS=

# ── PostgreSQL (Keycloak backend) ──────────────────────────────────────────────
POSTGRES_USER=keycloak
POSTGRES_PASS=
