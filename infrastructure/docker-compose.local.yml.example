name: clync-dev

services:
  postgres:
    image: "docker.io/library/postgres:17-alpine"
    restart: unless-stopped
    environment:
      - "POSTGRES_DB=keycloak"
      - "POSTGRES_USER=keycloak"
      - "POSTGRES_PASSWORD=keycloak"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U keycloak"]
      interval: 5s
      timeout: 5s
      retries: 10

  keycloak:
    image: "quay.io/keycloak/keycloak:26.6.1"
    command: "start-dev --import-realm"
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "127.0.0.1:8080:8080"
    environment:
      - "KC_BOOTSTRAP_ADMIN_USERNAME=admin"
      - "KC_BOOTSTRAP_ADMIN_PASSWORD=admin"
      - "KC_DB=postgres"
      - "KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak"
      - "KC_DB_USERNAME=keycloak"
      - "KC_DB_PASSWORD=keycloak"
    volumes:
      - ./keycloak:/opt/keycloak/data/import:ro

  surrealdb:
    image: "docker.io/surrealdb/surrealdb:v2"
    command: "start --bind 0.0.0.0:8000 --user root --pass root file:///data/clync.db"
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "3"
    ports:
      - "127.0.0.1:8000:8000"
    volumes:
      - surrealdb_data:/data:U

  # ── Prometheus (dev) ────────────────────────────────────────────────────────
  # Backend runs on the host — host.docker.internal resolves to the host machine.
  prometheus:
    image: docker.io/prom/prometheus:v3
    restart: unless-stopped
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=7d'
    ports:
      - "127.0.0.1:9090:9090"
    volumes:
      - ./monitoring/prometheus.local.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus

  # ── Grafana (dev) ────────────────────────────────────────────────────────────
  grafana:
    image: docker.io/grafana/grafana:latest
    restart: unless-stopped
    ports:
      - "127.0.0.1:3001:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_DISABLE_LOGIN_FORM: "false"
    volumes:
      - grafana_data:/var/lib/grafana
      - ./monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      - prometheus

# Backend environment — VAPID keys for Web Push notifications.
# Generate a fresh key pair: npx web-push generate-vapid-keys
# Copy this file to docker-compose.local.yml and fill in your keys.
x-backend-env: &backend-env
  VAPID_PUBLIC_KEY: ""
  VAPID_PRIVATE_KEY: ""
  VAPID_SUBJECT: "mailto:dev@clync.local"

volumes:
  postgres_data:
  surrealdb_data:
  prometheus_data:
  grafana_data:
