{
  "title": "Clync Backend",
  "uid": "clync-backend",
  "version": 2,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "hide": 2 },
      { "name": "DS_LOKI",       "type": "datasource", "query": "loki",       "hide": 2 }
    ]
  },
  "panels": [

    { "id": 1, "type": "row", "title": "Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 2, "title": "Total req/s", "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum(rate(axum_http_requests_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 3, "title": "OK (2xx) %", "type": "stat",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "refId": "A",
        "expr": "100 * sum(rate(axum_http_requests_total{status=~\"2..\"}[1m])) / sum(rate(axum_http_requests_total[1m]))"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 99 }] } } }
    },
    {
      "id": 4, "title": "Auth Errors/s (401/403)", "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum(rate(axum_http_requests_total{status=~\"401|403\"}[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.1 }, { "color": "orange", "value": 1 }] } } }
    },
    {
      "id": 5, "title": "Server Errors/s (5xx)", "type": "stat",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "refId": "A", "expr": "sum(rate(axum_http_requests_total{status=~\"5..\"}[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.01 }] } } }
    },

    { "id": 10, "type": "row", "title": "Request Rate & Status", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 11, "title": "Requests per Endpoint (req/s)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 14, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(axum_http_requests_total[1m])) by (method, endpoint)",
        "legendFormat": "{{method}} {{endpoint}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 12, "title": "Status Breakdown (req/s)", "type": "timeseries",
      "gridPos": { "x": 14, "y": 6, "w": 10, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(axum_http_requests_total{status=~\"2..\"}[1m]))",     "legendFormat": "OK (2xx)" },
        { "refId": "B", "expr": "sum(rate(axum_http_requests_total{status=~\"401|403\"}[1m]))", "legendFormat": "Auth Error (401/403)" },
        { "refId": "C", "expr": "sum(rate(axum_http_requests_total{status=~\"4[02456789][0-9]|4[1][0-9]\"}[1m]))", "legendFormat": "Other 4xx" },
        { "refId": "D", "expr": "sum(rate(axum_http_requests_total{status=~\"5..\"}[1m]))",     "legendFormat": "Server Error (5xx)" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "OK (2xx)" },            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Auth Error (401/403)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Other 4xx" },           "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Server Error (5xx)" },  "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] }
        ]
      }
    },

    { "id": 20, "type": "row", "title": "Endpoint Detail", "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 21, "title": "Endpoint Breakdown (last hour)", "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, endpoint) (increase(axum_http_requests_total[1h]))",
          "instant": true, "format": "table", "legendFormat": ""
        },
        {
          "refId": "B",
          "expr": "sum by (method, endpoint) (increase(axum_http_requests_total{status=~\"2..\"}[1h]))",
          "instant": true, "format": "table", "legendFormat": ""
        },
        {
          "refId": "C",
          "expr": "sum by (method, endpoint) (increase(axum_http_requests_total{status=~\"401|403\"}[1h]))",
          "instant": true, "format": "table", "legendFormat": ""
        },
        {
          "refId": "D",
          "expr": "sum by (method, endpoint) (increase(axum_http_requests_total{status=~\"5..\"}[1h]))",
          "instant": true, "format": "table", "legendFormat": ""
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "Total",
              "Value #B": "OK (2xx)",
              "Value #C": "Auth Error (401/403)",
              "Value #D": "Server Error (5xx)",
              "endpoint": "Endpoint",
              "method": "Method"
            },
            "indexByName": { "Method": 0, "Endpoint": 1, "Total": 2, "OK (2xx)": 3, "Auth Error (401/403)": 4, "Server Error (5xx)": 5 },
            "excludeByName": { "Time": true }
          }
        },
        { "id": "sortBy", "options": { "fields": [{ "displayName": "Total", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "displayMode": "auto", "align": "auto" }, "decimals": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "OK (2xx)" },            "properties": [{ "id": "custom.displayMode", "value": "color-text" }, { "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Auth Error (401/403)" },"properties": [{ "id": "custom.displayMode", "value": "color-text" }, { "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Server Error (5xx)" },  "properties": [{ "id": "custom.displayMode", "value": "color-text" }, { "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Total" },               "properties": [{ "id": "custom.displayMode", "value": "lcd-gauge" }] }
        ]
      },
      "options": { "sortBy": [{ "displayName": "Total", "desc": true }] }
    },

    { "id": 30, "type": "row", "title": "Latency", "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 31, "title": "p95 Latency per Endpoint (ms)", "type": "timeseries",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum(rate(axum_http_requests_duration_seconds_bucket[5m])) by (le, method, endpoint)) * 1000",
        "legendFormat": "{{method}} {{endpoint}}"
      }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } }
    },

    { "id": 40, "type": "row", "title": "Logs", "gridPos": { "x": 0, "y": 36, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 41, "title": "Backend Logs", "type": "logs",
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{service=\"backend\"}" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": false, "dedupStrategy": "none" }
    },
    {
      "id": 42, "title": "Error Logs Only", "type": "logs",
      "gridPos": { "x": 0, "y": 47, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{service=\"backend\"} | json | level =~ \"error|warn\"" }],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none" }
    }
  ]
}
