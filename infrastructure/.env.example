# Copy to .env and fill in all values before first deployment.
# Never commit .env — it contains secrets.

# ── Hostnames ──────────────────────────────────────────────────────────────────
FRONTEND_HOST=clync.example.com
API_HOST=api.clync.example.com
KEYCLOAK_HOST=auth.clync.example.com

# ── Frontend (baked into the image at build time via docker compose build) ─────
VITE_API_URL=https://api.clync.example.com
VITE_KEYCLOAK_URL=https://auth.clync.example.com
VITE_KEYCLOAK_REALM=Clync
VITE_KEYCLOAK_CLIENT_ID=clync

# URL used by the backend for CORS — must match FRONTEND_HOST
FRONTEND_URL=https://clync.example.com

# ── VAPID (Web Push) ───────────────────────────────────────────────────────────
# Generate a fresh key pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@clync.example.com

# ── SurrealDB ──────────────────────────────────────────────────────────────────
SURREALDB_USER=surrealdb
SURREALDB_PASS=

# ── Keycloak ───────────────────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASS=

# ── PostgreSQL (Keycloak backend) ──────────────────────────────────────────────
POSTGRES_USER=keycloak
POSTGRES_PASS=
