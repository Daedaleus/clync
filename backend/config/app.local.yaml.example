# Local configuration overrides — copy to app.local.yaml and fill in values:
#   cp config/app.local.yaml.example config/app.local.yaml
#
# This file is GITIGNORED. Never commit app.local.yaml.
# Only list values that differ from app.yaml defaults.

vapid:
  # Generate: npx web-push generate-vapid-keys
  public_key: "REPLACE_ME"
  private_key: "REPLACE_ME"
  subject: "mailto:your@email.com"

